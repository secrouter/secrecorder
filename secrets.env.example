# SecRecorder secrets — copy to `secrets.env`, fill in, then run: ./install.sh secrets.env
# The installer writes this to `.env` (chmod 600), which the server loads at startup.
#
# HF_TOKEN is required ONLY for speaker diarization (the pyannote model is gated). Transcription
# needs no secrets. Create a read token at https://huggingface.co/settings/tokens and accept
# https://huggingface.co/pyannote/speaker-diarization-community-1

HF_TOKEN=

# ── Optional SSO auth (SecSSO / OIDC) — all OFF unless set; see README "SSO authentication" ──
# Set ISSUER + CLIENT_ID to require a SecSSO bearer JWT on /v1/*. Add CLIENT_SECRET + PUBLIC_URL +
# SESSION_SECRET to also log the built-in web UI in through SecSSO (Authorization Code + PKCE).
# In the SecRouter suite, SecDeploy provisions and fills these for you.
# SECRECORDER_OIDC_ISSUER=
# SECRECORDER_OIDC_CLIENT_ID=secrecorder
# SECRECORDER_OIDC_CLIENT_SECRET=
# SECRECORDER_PUBLIC_URL=
# SECRECORDER_SESSION_SECRET=

# ── Optional summarization — OFF unless ENABLED + ENDPOINT set; see README "Summarization" ──
# Point ENDPOINT at SecRouter (…/v1) for a governed, audited, per-user summarization call.
# SECRECORDER_SUMMARIZE_ENABLED=1
# SECRECORDER_SUMMARIZE_ENDPOINT=
# SECRECORDER_SUMMARIZE_MODEL=auto
# SECRECORDER_SUMMARIZE_API_KEY=
