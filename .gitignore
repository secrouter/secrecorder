# secrets — NEVER commit (HF token lives here)
.env
secrets.env

# environment / caches
.venv/
__pycache__/
*.pyc

# runtime logs
*.log

# speaker library (enrolled voiceprints — machine-local, may hold biometric data)
*.db
*.db-wal
*.db-shm

# tamper-evident audit trail — per-deployment runtime data, never commit (back up/forward per your
# retention policy instead; see docs/control-validation.md)
/data/

# test audio + benchmark data (large / machine-specific) — but keep the .md result docs
*.wav
*.aiff
bench/assets/
bench/**/*.json
